<?php function create_job_description(string$title,string$dept,string$summary,string$resp,string$qual):int{global$db;$db->query("INSERT INTO ".TB_PREF."job_descriptions(title,department,summary,responsibilities,qualifications,created_by)VALUES(".$db->escape($title).",".$db->escape($dept).",".$db->escape($summary).",".$db->escape($resp).",".$db->escape($qual).",".user_id().")");return$db->insert_id;} function get_job_descriptions(array$f=[]):?object{global$db;$s="SELECT*FROM ".TB_PREF."job_descriptions WHERE status='Active'";if(!empty($f['department']))$s.=" AND department=".$db->escape($f['department']);$s.=" ORDER BY title";return$db->query($s);}